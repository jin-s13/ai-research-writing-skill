{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jin-s13/ai-research-writing-skill/numeric-evidence.schema.json",
  "title": "Numeric Evidence Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "ai-research-writing/numeric-evidence-v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "source"],
        "properties": {
          "value": {"type": "number"},
          "source": {"type": "string", "minLength": 1},
          "locator": {"type": "string"},
          "representations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["raw", "percent"]}
          },
          "tolerance": {"type": "number", "minimum": 0},
          "note": {"type": "string"}
        }
      }
    }
  }
}
