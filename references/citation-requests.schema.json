{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jin-s13/ai-research-writing-skill/citation-requests.schema.json",
  "title": "Citation Verification Requests",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "ai-research-writing/citation-requests-v1"},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "identifier", "claim_support"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "identifier": {"type": "string", "pattern": "^(doi|DOI|arxiv|ARXIV):.+"},
          "claim_support": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["claim", "relation", "status", "evidence", "source"],
              "properties": {
                "claim": {"type": "string", "minLength": 1},
                "relation": {"enum": ["direct", "background", "contrast", "software", "partial", "weak", "metadata-only"]},
                "status": {"type": "string", "minLength": 1},
                "evidence": {"type": "string", "minLength": 1},
                "source": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
